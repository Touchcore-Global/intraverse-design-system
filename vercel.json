{
  "rewrites": [
    {
      "source": "/((?!sitemap\\.xml|robots\\.txt|og/|.*\\.(?:xml|txt|png|jpg|jpeg|svg|webp|ico|json|js|css|woff|woff2|ttf|map)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ]
}
